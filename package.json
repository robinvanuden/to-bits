{
  "name": "to-bits",
  "version": "0.2.1",
  "scripts": {
    "clean": "rm -r dist && rm -r .parcel-cache",
    "dev:server": "nodemon --watch src src/index.ts",
    "dev:client": "npm run clean && parcel public/index.html --port=3001",
    "dev": "npm run dev:client & npm run dev:server",
    "build:client": "npm run clean && parcel build public/index.html",
    "start:server": "ts-node src/index.ts",
    "start": "parcel build public/index.html && ts-node src/index.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.10.0",
    "@types/express": "^4.17.20",
    "@types/uuid": "^9.0.6",
    "buffer": "^6.0.3",
    "nodemon": "^3.0.1",
    "parcel": "^2.10.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "sass": "^1.69.5"
  }
}
