{
  "name": "to-bits",
  "version": "0.3.4",
  "scripts": {
    "clean": "rm -r dist & rm -r .parcel-cache || echo 'nope'",
    "dev:server": "nodemon --watch src src/index.ts",
    "dev:client": "npm run clean && parcel public/index.html --port=3001",
    "dev": "npm run dev:client & npm run dev:server",
    "build:client": "npm run clean && parcel build public/index.html",
    "start:server": "ts-node src/index.ts",
    "start": "parcel build public/index.html & ts-node src/index.ts"
  },
  "dependencies": {
    "color": "^4.2.3",
    "express": "^4.18.2",
    "sharp": "^0.33.1",
    "socket.io": "^4.7.2",
    "socket.io-client": "^4.7.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.10.3",
    "@types/color": "^3.0.6",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "buffer": "^6.0.3",
    "nodemon": "^3.0.2",
    "parcel": "^2.10.3",
    "sass": "^1.69.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
