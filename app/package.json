{
  "name": "to-bits",
  "version": "0.5.4",
  "author": {
    "name": "Robin van Uden",
    "email": "hello@robinvanuden.com",
    "url": "https://www.robinvanuden.com"
  },
  "private": true,
  "scripts": {
    "clean": "rm -r dist & rm -r .parcel-cache || echo 'nope'",
    "dev:server": "nodemon --watch src src/index.ts",
    "dev:client": "npm run clean && parcel public/main.html --port=3001",
    "dev": "npm run dev:client & npm run dev:server",
    "build:client": "npm run clean && parcel build public/main.html",
    "start:server": "ts-node src/index.ts",
    "start:clean": "npm run clean && npm run start",
    "start": "parcel build public/main.html && ts-node src/index.ts",
    "test": "eslint src/*/**.ts public/*/**.ts"
  },
  "dependencies": {
    "color": "^4.2",
    "express": "^4.19",
    "sharp": "^0.33",
    "socket.io": "^4.7",
    "socket.io-client": "^4.7",
    "unique-names-generator": "^4.7",
    "uuid": "^9.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12",
    "@types/color": "^3.0",
    "@types/cookie-parser": "^1.4",
    "@types/express": "^4.17",
    "@types/uuid": "^9.0",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "buffer": "^6.0",
    "cookie-parser": "^1.4",
    "eslint": "^8.57.0",
    "nodemon": "^3.1",
    "parcel": "^2.12",
    "sass": "^1.72",
    "ts-node": "^10.9",
    "typescript": "^5.4"
  }
}
