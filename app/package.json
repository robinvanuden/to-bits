{
  "name": "to-bits",
  "version": "0.4.3",
  "author": {
    "name": "Robin van Uden",
    "email": "hello@robinvanuden.com",
    "url": "https://www.robinvanuden.com"
  },
  "engines": {
    "node": "20"
  },
  "private": true,
  "scripts": {
    "clean": "rm -r dist & rm -r .parcel-cache || echo 'nope'",
    "dev:server": "nodemon --watch src src/index.ts",
    "dev:client": "npm run clean && parcel public/main.html --port=3001",
    "dev": "npm run dev:client & npm run dev:server",
    "build:client": "npm run clean && parcel build public/main.html",
    "start:server": "ts-node src/index.ts",
    "start": "parcel build public/main.html & ts-node src/index.ts"
  },
  "dependencies": {
    "color": "^4.2.3",
    "express": "^4.18.3",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "unique-names-generator": "^4.7.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12.0",
    "@types/color": "^3.0.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.8",
    "buffer": "^6.0.3",
    "cookie-parser": "^1.4.6",
    "nodemon": "^3.1.0",
    "parcel": "^2.12.0",
    "sass": "^1.72.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
