{
  "name": "to-bits",
  "version": "0.7.0",
  "private": true,
  "author": {
    "name": "Robin van Uden",
    "email": "code@robinvanuden.com",
    "url": "https://www.robinvanuden.com"
  },
  "scripts": {
    "clean": "rm -r dist && rm -r .parcel-cache || echo 'nope'",
    "clean:fake": "mkdir dist & mkdir .parcel-cache || echo 'nope'",
    "dev:server": "nodemon --watch src -e ts,json src/index.ts",
    "dev:client": "parcel public/main.html --port=3001",
    "dev": "npm run clean && npm run dev:client & npm run dev:server",
    "build": "parcel build public/main.html",
    "start": "ts-node src/index.ts",
    "test": "eslint src/*/**.ts public/*/**.ts"
  },
  "dependencies": {
    "express": "^4.19",
    "sharp": "^0.33",
    "socket.io": "^4.7",
    "socket.io-client": "^4.7",
    "unique-names-generator": "^4.7",
    "uuid": "^10.0"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.12",
    "@types/color": "^3.0",
    "@types/cookie-parser": "^1.4",
    "@types/express": "^4.17",
    "@types/uuid": "^10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "buffer": "^6.0",
    "cookie-parser": "^1.4",
    "eslint": "^9.8",
    "nodemon": "^3.1",
    "parcel": "^2.12",
    "sass": "^1.77",
    "ts-node": "^10.9",
    "typescript": "^5.5"
  }
}
